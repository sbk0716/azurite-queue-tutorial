# ============================================================
# Dockerfile
# ============================================================
#
# 概要:
#   API Server と Worker の両方で使用する Docker イメージを定義。
#   実行時のコマンドで起動するアプリケーションを切り替えます。
#
# 使用方法:
#   ビルド: docker build -t azurite-queue-tutorial .
#   実行: docker compose up（compose.yaml で管理）
#
# 設計上の決定:
#   - Python 3.12 slim イメージをベース（軽量）
#   - bullseye（Debian 11）を使用（Azure App Service と互換）
#   - 企業プロキシ環境用の SSL 証明書設定を含む
#
# ============================================================

# ============================================================
# ベースイメージ
# ============================================================
# Python 3.12 のスリムイメージをベースに使用
# bullseye: Debian 11（GLIBC 2.31 互換）
# Azure App Service のランタイムと同じ Debian バージョンを使用
#
# イメージサイズの比較:
# - python:3.12（フル）: ~900MB
# - python:3.12-slim: ~150MB
# - python:3.12-alpine: ~50MB（GLIBC 非互換の問題あり）
#
FROM python:3.12-slim-bullseye

# ============================================================
# 作業ディレクトリ
# ============================================================
# コンテナ内の作業ディレクトリを /app に設定
# 以降のコマンドはこのディレクトリを基準に実行
#
WORKDIR /app

# ============================================================
# システムパッケージのインストール
# ============================================================
# 必要最小限のシステムパッケージをインストール
#
# ca-certificates: SSL/TLS 証明書（HTTPS 通信用）
# curl: ヘルスチェックや動作確認用
#
# --no-install-recommends: 推奨パッケージをインストールしない（軽量化）
# rm -rf /var/lib/apt/lists/*: apt キャッシュを削除（軽量化）
#
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# SSL 証明書の設定（企業プロキシ対応）
# ============================================================
# 社内プロキシで SSL インスペクションが行われる環境では、
# カスタム CA 証明書の追加が必要です。
#
# 使用手順:
# 1. cert/nscacert.pem にプロキシの CA 証明書を配置
# 2. このセクションのコメントを解除
# 3. イメージを再ビルド
#
# 注意: 一般的な環境では不要（コメントアウトして使用）
#
COPY cert/nscacert.pem /etc/ssl/certs/nscacert.pem
RUN update-ca-certificates

# ============================================================
# 環境変数の設定
# ============================================================

# SSL 証明書関連の環境変数
# ----------------------------------------
# Python の requests ライブラリや Azure SDK が使用する
# CA バンドルのパスを指定
#
# REQUESTS_CA_BUNDLE: requests ライブラリが参照
# SSL_CERT_FILE: 標準 SSL ライブラリが参照
#
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/nscacert.pem \
    SSL_CERT_FILE=/etc/ssl/certs/nscacert.pem

# Python 関連の環境変数
# ----------------------------------------
# PYTHONDONTWRITEBYTECODE=1: .pyc ファイルを生成しない（軽量化）
# PYTHONUNBUFFERED=1: 標準出力をバッファリングしない（ログ即時出力）
# PIP_NO_CACHE_DIR=1: pip キャッシュを使用しない（軽量化）
# PYTHONPATH=/app: Python モジュール検索パスに /app を追加
#
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

# ============================================================
# pip のアップグレード
# ============================================================
# 最新版の pip を使用（セキュリティ・互換性向上）
#
RUN pip install -U pip

# ============================================================
# Python 依存関係のインストール
# ============================================================
# requirements.txt を先にコピーしてインストール
# Docker のレイヤーキャッシュを活用:
# - requirements.txt が変更されない限り、このレイヤーはキャッシュされる
# - コード変更時のビルド時間を短縮
#
COPY requirements.txt ./
RUN pip install -r requirements.txt

# ============================================================
# アプリケーションコードのコピー
# ============================================================
# プロジェクト全体をコンテナにコピー
# .dockerignore で不要なファイルを除外（__pycache__, .git など）
#
COPY . /app/

# ============================================================
# ポートの公開
# ============================================================
# FastAPI がリッスンするポートを公開
# EXPOSE は文書化目的（実際のポート公開は docker compose で行う）
#
EXPOSE 8000

# ============================================================
# デフォルトの起動コマンド
# ============================================================
# コンテナ起動時のデフォルトコマンド
# FastAPI（API Server）として起動
#
# 注意: docker compose で command を上書きするため、
# これはフォールバック（単独実行時）用
#
# uvicorn オプション:
# --host 0.0.0.0: 全インターフェースでリッスン
# --port 8000: リッスンポート
# --log-level debug: 詳細ログ出力（本番では info 推奨）
#
CMD ["uvicorn", "apps.api.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "debug"]
